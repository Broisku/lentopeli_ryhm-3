# Auto-detect text files and normalize line endings
* text=auto

# Force specific file types to use LF (Unix/macOS style)
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf


# Windows-specific scripts (if any)
*.bat text eol=crlf